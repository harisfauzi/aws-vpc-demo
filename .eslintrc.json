{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:yml/standard",
    "plugin:prettier/recommended",
    "plugin:json/recommended"
  ],
  "plugins": [
    "jinja2"
  ],
  "overrides": [
    {
      "files": ["*.yaml", "*.yml"],
      "parser": "yaml-eslint-parser",
      "rules": {
        "prettier/prettier": "off",
        "yml/no-empty-mapping-value": "off",
        "yml/plain-scalar": "off"
      },
      "parserOptions": {
        "defaultYAMLVersion": "1.2"
      }
    }
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {}
}
